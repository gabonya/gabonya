    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <application android:label="@string/app_name" android:allowBackup="false" android:hasCode="true">
        <activity android:name="x.Go" android:theme="@android:style/Theme.NoDisplay" android:exported="true" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
